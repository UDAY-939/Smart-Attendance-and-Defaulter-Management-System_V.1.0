# Copy this file and fill in your actual values.
# On Render: set these as Environment Variables in the dashboard (do NOT commit .env)

# TiDB Cloud connection string
# Format: mysql+pymysql://<user>:<password>@<host>:4000/<database>?charset=utf8mb4&ssl_mode=VERIFY_IDENTITY
DATABASE_URL=mysql+pymysql://your_tidb_user:your_password@your_tidb_host:4000/attendance_db?charset=utf8mb4

# Flask secret key (generate a random string, e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# Admin account auto-created on first launch
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

